---
// Nosotros.astro — Estilo "Behind the Company Stories" (HomeMaster)
---

<section id="nosotros" class="nos-section">
  <div class="nos-container container">

    <!-- ── Galería visual — izquierda ── -->
    <div class="nos-gallery" aria-hidden="true">
      <div class="gallery-main">
        <img
          src="/images/cat_limpiapisos.png"
          alt="Equipo de limpieza profesional"
          class="gallery-img gallery-img--main"
          loading="lazy"
        />
      </div>
      <div class="gallery-secondary">
        <div class="gallery-small">
          <img
            src="/images/cat_detergente.png"
            alt="Detergentes de calidad"
            class="gallery-img"
            loading="lazy"
          />
        </div>
        <div class="gallery-small">
          <img
            src="/images/cat_lavandina.png"
            alt="Lavandinas concentradas"
            class="gallery-img"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- ── Contenido — derecha ── -->
    <div class="nos-content">
      <span class="nos-badge">Nuestra Identidad</span>

      <h2 class="nos-title">
        Hacemos que el suministro de limpieza sea simple y eficiente
      </h2>

      <p class="nos-desc">
        Somos una distribuidora paceña comprometida con la calidad y la
        confianza. Brindamos soluciones de higiene accesibles a hogares,
        comercios y empresas, garantizando atención inmediata y stock permanente.
      </p>

      <!-- Checks en dos columnas -->
      <div class="nos-checks">
        <div class="check-item">
          <span class="check-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Limpieza Confiable y Segura</span>
        </div>
        <div class="check-item">
          <span class="check-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Entrega Rápida en La Paz</span>
        </div>
        <div class="check-item">
          <span class="check-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Purifica y Revitaliza</span>
        </div>
        <div class="check-item">
          <span class="check-dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span>Altos Estándares de Higiene</span>
        </div>
      </div>

      <!-- Stats -->
      <div class="nos-stats">
        <div class="stat-item">
          <span class="stat-num">1.2K+</span>
          <span class="stat-label">Pedidos Entregados</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">15+</span>
          <span class="stat-label">Líneas de Distribución</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num">98%</span>
          <span class="stat-label">Clientes Satisfechos</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .nos-section {
    font-family: "Manrope", sans-serif;
    background: #ffffff;
    padding: 4rem 0;
    overflow: hidden;
  }

  .nos-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* ── Gallery ── */
  .nos-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .gallery-main {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .gallery-secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .gallery-small {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-main:hover .gallery-img,
  .gallery-small:hover .gallery-img {
    transform: scale(1.04);
  }

  /* ── Content ── */
  .nos-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .nos-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(234, 118, 56, 0.1);
    border: 1px solid rgba(234, 118, 56, 0.3);
    border-radius: 50px;
    padding: 0.3rem 1rem;
  }

  .nos-title {
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin: 0;
  }

  .nos-desc {
    font-size: 0.93rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
  }

  /* ── Checks ── */
  .nos-checks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 1.5rem;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .check-dot {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    background: var(--color-primary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Stats ── */
  .nos-stats {
    display: flex;
    align-items: center;
    background: var(--color-light-gray);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    gap: 0;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    text-align: center;
  }

  .stat-num {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
    line-height: 1.3;
    text-align: center;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .nos-section {
      padding: 5rem 0;
    }
    .nos-container {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .nos-gallery {
      order: 1;
    }
    .nos-content {
      order: 2;
    }
  }

  @media (min-width: 1024px) {
    .nos-section {
      padding: 6rem 0;
    }
    .nos-container {
      gap: 5rem;
    }
  }
</style>
