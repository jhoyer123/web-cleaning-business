---
// Contacto.astro — Banner CTA naranja + formulario
---

<!-- Banner CTA naranja (estilo HomeMaster bottom banner) -->
<div class="cta-banner">
  <div class="cta-inner container">
    <div class="cta-text">
      <h2 class="cta-title">
        ¿Listo para equipar su espacio con la mejor limpieza?
      </h2>
      <p class="cta-desc">
        Contáctenos ahora y reciba atención personalizada. Entregas en La Paz y
        alrededores.
      </p>
    </div>
    <a
      href="https://wa.me/59170000000?text=Hola,%20quiero%20hacer%20un%20pedido%20de%20productos%20de%20limpieza."
      target="_blank"
      rel="noopener noreferrer"
      class="cta-btn"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      Escribir por WhatsApp
    </a>
  </div>
</div>

<!-- Sección de contacto y formulario -->
<section id="contacto" class="contact-section">
  <div class="contact-wrap container">
    <div class="contact-header">
      <span class="contact-badge">Atención Rápida</span>
      <h2 class="contact-heading">Contacto y Pedidos</h2>
      <p class="contact-subtitle">
        ¿Tiene alguna consulta o desea realizar un pedido al por mayor?
        Escríbanos o visítenos. Respondemos a la brevedad.
      </p>
    </div>

    <div class="contact-grid">
      <!-- Panel info -->
      <div class="contact-info-panel">
        <h3 class="contact-panel-title">Información de Distribución</h3>

        <div class="info-list">
          <div class="info-item">
            <div class="info-icon info-icon--green">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
            </div>
            <div class="info-body">
              <h4 class="info-label">WhatsApp y Teléfono</h4>
              <p class="info-text">
                <a
                  href="https://wa.me/59170000000?text=Hola,%20quisiera%20hacer%20una%20consulta."
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link-highlight"
                >
                  +591 700 00000
                </a>
              </p>
              <p class="info-sub">
                Atención directa para cotizaciones y despachos.
              </p>
            </div>
          </div>

          <div class="info-divider"></div>

          <div class="info-item">
            <div class="info-icon info-icon--orange">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
            </div>
            <div class="info-body">
              <h4 class="info-label">Dirección del Almacén</h4>
              <p class="info-text">Av. Kollasuyo Nº 1245, Zona Cementerio</p>
              <p class="info-sub">La Paz, Bolivia</p>
            </div>
          </div>

          <div class="info-divider"></div>

          <div class="info-item">
            <div class="info-icon info-icon--green">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
            </div>
            <div class="info-body">
              <h4 class="info-label">Horarios de Atención</h4>
              <div class="horarios-grid">
                <div class="horario-row">
                  <span class="horario-dia">Lun – Vie</span>
                  <span class="horario-hora">08:30 – 18:30</span>
                </div>
                <div class="horario-row">
                  <span class="horario-dia">Sábados</span>
                  <span class="horario-hora">09:00 – 13:00</span>
                </div>
              </div>
              <p class="info-sub">Domingos y Feriados cerrado.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel formulario -->
      <div class="contact-form-panel">
        <h3 class="contact-panel-title">Envíenos un Mensaje</h3>

        <div id="formState">
          <form class="contact-form" id="contactForm" novalidate>
            <div class="form-group">
              <label for="form-name" class="form-label">Nombre Completo</label>
              <input
                type="text"
                id="form-name"
                class="form-input"
                required
                placeholder="Ej. Juan Pérez"
              />
              <span class="form-error" id="err-name"
                >Por favor ingrese su nombre.</span
              >
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="form-email" class="form-label"
                  >Correo (Opcional)</label
                >
                <input
                  type="email"
                  id="form-email"
                  class="form-input"
                  placeholder="juan@ejemplo.com"
                />
              </div>
              <div class="form-group">
                <label for="form-phone" class="form-label">Teléfono</label>
                <input
                  type="tel"
                  id="form-phone"
                  class="form-input"
                  required
                  placeholder="Ej. 71234567"
                />
                <span class="form-error" id="err-phone"
                  >Por favor ingrese su teléfono.</span
                >
              </div>
            </div>

            <div class="form-group">
              <label for="form-message" class="form-label"
                >Detalle del Pedido o Consulta</label
              >
              <textarea
                id="form-message"
                class="form-textarea"
                required
                placeholder="Escriba los productos o la consulta comercial que desea realizar..."
              ></textarea>
              <span class="form-error" id="err-msg"
                >Por favor escriba su consulta.</span
              >
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
              <span id="btnText">Enviar Formulario</span>
              <svg
                id="btnSpinner"
                class="spinner hidden"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                width="18"
                height="18"
              >
                <circle cx="12" cy="12" r="10" stroke-opacity="0.3"></circle>
                <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
              </svg>
            </button>
          </form>
        </div>

        <div id="successState" class="success-state hidden">
          <div class="success-icon-wrap">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              width="36"
              height="36"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h4 class="success-title">¡Mensaje enviado!</h4>
          <p class="success-desc">
            Nos pondremos en contacto con usted a la brevedad. Gracias por
            escribirnos.
          </p>
          <button class="btn-reset" id="resetBtn">Enviar otro mensaje</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  const formState = document.getElementById("formState") as HTMLElement | null;
  const successState = document.getElementById(
    "successState",
  ) as HTMLElement | null;
  const submitBtn = document.getElementById(
    "submitBtn",
  ) as HTMLButtonElement | null;
  const btnText = document.getElementById("btnText") as HTMLElement | null;
  const btnSpinner = document.getElementById(
    "btnSpinner",
  ) as HTMLElement | null;
  const resetBtn = document.getElementById(
    "resetBtn",
  ) as HTMLButtonElement | null;

  function showError(id: string, show: boolean): void {
    const el = document.getElementById(id);
    if (el) el.classList.toggle("visible", show);
  }

  function validateForm(): boolean {
    const nameEl = document.getElementById(
      "form-name",
    ) as HTMLInputElement | null;
    const phoneEl = document.getElementById(
      "form-phone",
    ) as HTMLInputElement | null;
    const msgEl = document.getElementById(
      "form-message",
    ) as HTMLTextAreaElement | null;
    const name = nameEl ? nameEl.value.trim() : "";
    const phone = phoneEl ? phoneEl.value.trim() : "";
    const msg = msgEl ? msgEl.value.trim() : "";
    showError("err-name", !name);
    showError("err-phone", !phone);
    showError("err-msg", !msg);
    return !!(name && phone && msg);
  }

  if (form) {
    form.addEventListener("submit", async (e: Event) => {
      e.preventDefault();
      if (!validateForm()) return;
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "Enviando...";
      if (btnSpinner) btnSpinner.classList.remove("hidden");
      await new Promise((r) => setTimeout(r, 1800));
      if (formState) formState.classList.add("hidden");
      if (successState) {
        successState.classList.remove("hidden");
        successState.classList.add("fade-in");
      }
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener("click", () => {
      if (form) form.reset();
      if (successState) {
        successState.classList.add("hidden");
        successState.classList.remove("fade-in");
      }
      if (formState) formState.classList.remove("hidden");
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = "Enviar Formulario";
      if (btnSpinner) btnSpinner.classList.add("hidden");
      ["err-name", "err-phone", "err-msg"].forEach((id) =>
        showError(id, false),
      );
    });
  }

  ["form-name", "form-phone", "form-message"].forEach((id) => {
    const el = document.getElementById(id);
    const errMap: Record<string, string> = {
      "form-name": "err-name",
      "form-phone": "err-phone",
      "form-message": "err-msg",
    };
    el?.addEventListener("input", () => showError(errMap[id], false));
  });
</script>

<style>
  /* ── CTA Banner naranja ── */
  .cta-banner {
    font-family: "Manrope", sans-serif;
    background: linear-gradient(135deg, #ea7638 0%, #d05e24 100%);
    padding: 2.5rem 0;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .cta-title {
    font-size: clamp(1.3rem, 3.5vw, 2rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.3px;
  }

  .cta-desc {
    font-size: 0.93rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.65;
    margin: 0.5rem 0 0;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #ffffff;
    color: #ea7638;
    font-family: "Manrope", sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.8rem 2rem;
    border-radius: 50px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  /* ── Contact Section ── */
  .contact-section {
    font-family: "Manrope", sans-serif;
    background: var(--color-light-gray);
    padding: 4rem 0;
  }

  /* ── Header ── */
  .contact-header {
    margin-bottom: 2.5rem;
    max-width: 600px;
  }

  .contact-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(234, 118, 56, 0.1);
    border: 1px solid rgba(234, 118, 56, 0.3);
    border-radius: 50px;
    padding: 0.3rem 1rem;
    margin-bottom: 0.75rem;
  }

  .contact-heading {
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin: 0 0 0.6rem;
  }

  .contact-subtitle {
    font-size: 0.93rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
  }

  /* ── Grid principal ── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  /* ── Panels ── */
  .contact-info-panel,
  .contact-form-panel {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 2rem 2.25rem;
    box-shadow: 0 2px 12px rgba(9, 61, 40, 0.05);
  }

  .contact-panel-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0 0 2rem;
    letter-spacing: -0.01em;
  }

  /* ── Info list ── */
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .info-divider {
    height: 1px;
    background: var(--color-border);
    margin: 1.25rem 0;
    opacity: 0.6;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .info-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .info-icon--green {
    background: var(--color-accent-light);
    color: var(--color-primary);
  }
  .info-icon--orange {
    background: rgba(234, 118, 56, 0.1);
    color: var(--color-accent);
  }

  .info-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .info-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin: 0 0 0.3rem;
  }

  .info-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.5;
  }

  .info-sub {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0;
  }

  .link-highlight {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .link-highlight:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* ── Horarios grid ── */
  .horarios-grid {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .horario-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .horario-dia {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-dark);
    min-width: 80px;
    flex-shrink: 0;
  }

  .horario-hora {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ── Form panel ── */
  .contact-form-panel {
    display: flex;
    flex-direction: column;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .form-input,
  .form-textarea {
    font-family: "Manrope", sans-serif;
    font-size: 0.9rem;
    color: var(--color-text-dark);
    background: var(--color-light-gray);
    border: 1.5px solid var(--color-border);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    width: 100%;
  }
  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(9, 61, 40, 0.1);
  }
  .form-textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-error {
    font-size: 0.74rem;
    color: #e53935;
    font-weight: 600;
    display: none;
  }
  .form-error.visible {
    display: block;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--color-primary);
    color: #fff;
    font-family: "Manrope", sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.85rem 2.25rem;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(9, 61, 40, 0.25);
    transition:
      background 0.2s,
      transform 0.2s;
    align-self: flex-start;
    margin-top: 0.5rem;
  }
  .btn-submit:hover:not(:disabled) {
    background: var(--color-primary-light);
    transform: translateY(-1px);
  }
  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .spinner {
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hidden {
    display: none !important;
  }

  /* ── Éxito ── */
  .success-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1rem;
    gap: 0.75rem;
    flex: 1;
  }
  .success-icon-wrap {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: var(--color-accent-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .success-title {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--color-primary);
    margin: 0;
  }
  .success-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 300px;
    margin: 0;
  }

  .btn-reset {
    margin-top: 0.5rem;
    background: none;
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    font-family: "Manrope", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.55rem 1.4rem;
    border-radius: 50px;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .btn-reset:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .fade-in {
    animation: fadeUp 0.4s ease forwards;
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Responsive ── */
  @media (min-width: 540px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 768px) {
    .contact-section {
      padding: 5rem 0;
    }
    .cta-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .contact-grid {
      grid-template-columns: 1fr 1.3fr;
      gap: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .contact-section {
      padding: 6rem 0;
    }
    .contact-grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 2.5rem;
    }
    .contact-info-panel {
      padding: 2.5rem;
    }
    .contact-form-panel {
      padding: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .contact-info-panel,
    .contact-form-panel {
      padding: 1.5rem 1.25rem;
    }
    .btn-submit {
      width: 100%;
    }
  }
</style>
