---
// Layout.astro
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Distribuidora de Productos de Limpieza | La Paz, Bolivia",
	description = "Distribución confiable de productos de limpieza para hogares, comercios y empresas en La Paz. Lavandina, detergente, limpiapisos y desengrasantes al mejor precio.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/images/hero_warehouse.png" />

		<!-- Google Fonts: Manrope -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	/* Layout-specific container properties */
</style>
